{
  "name": "siot-backend",
  "version": "0.1.0",
  "description": "SIOT zero-knowledge IoT platform — backend API",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen-cert": "node scripts/gen-dev-cert.js",
    "migrate": "node-pg-migrate -j js -m migrations --envPath .env",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^6.0.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.1",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "selfsigned": "^5.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
