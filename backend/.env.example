# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# HTTP listener. 0.0.0.0 so an ESP32 on the LAN can reach it.
HOST=0.0.0.0
PORT=3030

# Matches docker-compose.yml. Note port 5433 — 5432 is left to any native
# Postgres install so the two don't fight over the port.
DATABASE_URL=postgres://siot:siot@localhost:5433/siot
REDIS_URL=redis://localhost:6379

# Dev-only: serve ../frontend as static files from the backend so the test
# console is same-origin (no CORS, and session cookies will work later).
SERVE_TEST_FRONTEND=true

# TLS is mandatory by design, including on the LAN (design Section 4).
# Run `npm run gen-cert` once to create the dev key pair.
# Setting this to false is a debugging escape hatch, not a supported mode.
TLS_ENABLED=true
TLS_CERT_PATH=certs/dev-cert.pem
TLS_KEY_PATH=certs/dev-key.pem
